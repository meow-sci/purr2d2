<Project>
  <Import Project="Local.Build.props" Condition="Exists('Local.Build.props')" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <KSAFolder Condition="'$(KSAFolder)' == ''">$(KSA_DLL_DIR)</KSAFolder>
    <KSAFolder Condition="'$(KSAFolder)' == '' and Exists('$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/KSA.dll')">$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll</KSAFolder>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
