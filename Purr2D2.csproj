<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Purr2D2</AssemblyName>
    <RootNamespace>Purr2D2</RootNamespace>
    <Version>0.2.0</Version>
    <Description>Kitten-held lightsabers, spatial audio and native vessel cutting for KSA.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CreateModZip Condition="'$(CreateModZip)' == ''">true</CreateModZip>
    <ModStageDir>$(MSBuildProjectDirectory)/artifacts/stage/purr2d2</ModStageDir>
    <ModArchive>$(MSBuildProjectDirectory)/artifacts/dist/purr2d2-$(Version).zip</ModArchive>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="StarMap.API" Version="0.3.6" PrivateAssets="all" IncludeAssets="compile;build;analyzers" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" IncludeAssets="compile;build;analyzers" />
  </ItemGroup>
  <ItemGroup>
    <HostAssembly Include="KSA;BepuPhysics;BepuUtilities;Brutal.Core;Brutal.Concurrency;Brutal.Numerics;Brutal.Collections;Brutal.Memory;Brutal.Strings;Brutal.Maths;Brutal.ImGui;Brutal.ImGui.Abstractions;Brutal.Glfw;Brutal.Fmod;Brutal.Render.Common;Brutal.Render.Mesh;Brutal.Vulkan;Brutal.Vulkan.Abstractions;Brutal.Vulkan.Vma;Brutal.ShaderC;Brutal.Gltf;Brutal.Texture;Brutal.Texture.Abstractions;Planet.Core;Planet.Render.Core" />
    <Reference Include="@(HostAssembly)">
      <HintPath>$(KSAFolder)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateHostReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(KSAFolder)/%(HostAssembly.Identity).dll')" Text="Missing KSA reference %(HostAssembly.Identity).dll. Set KSA_DLL_DIR or KSAFolder to the complete 2026.10.19.5638 snapshot DLL directory." />
  </Target>
  <!-- Release builds always recreate the installable payload, including incremental builds. -->
  <Target Name="BuildModDistribution" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_StageFile Include="$(TargetPath);$(TargetDir)$(AssemblyName).deps.json;$(MSBuildProjectDirectory)/mod.toml;$(MSBuildProjectDirectory)/LICENSE;$(MSBuildProjectDirectory)/README.md" />
      <_StageAsset Include="$(MSBuildProjectDirectory)/Assets/**/*.xml;$(MSBuildProjectDirectory)/Assets/**/*.glb;$(MSBuildProjectDirectory)/Assets/**/*.png;$(MSBuildProjectDirectory)/Assets/**/*.wav;$(MSBuildProjectDirectory)/Assets/**/*.ogg;$(MSBuildProjectDirectory)/Assets/**/*.vert;$(MSBuildProjectDirectory)/Assets/**/*.frag;$(MSBuildProjectDirectory)/Assets/**/*.glsl" />
    </ItemGroup>
    <Error Condition="!Exists('%(_StageFile.Identity)')" Text="Required stage file missing: %(_StageFile.Identity)" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Assets/purr2d2.xml') or !Exists('$(MSBuildProjectDirectory)/Assets/Sounds.xml') or !Exists('$(MSBuildProjectDirectory)/Assets/PracticeTargets.xml')" Text="Required model, audio or practice-target asset manifest missing." />
    <PropertyGroup>
      <_ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/mod.toml')), '(?m)^version\s*=\s*&quot;([^&quot;]+)&quot;\s*$').Groups[1].Value)</_ManifestVersion>
    </PropertyGroup>
    <Error Condition="'$(_ManifestVersion)' != '$(Version)'" Text="mod.toml version '$(_ManifestVersion)' must match project Version '$(Version)' before building the distribution." />
    <RemoveDir Directories="$(ModStageDir)" />
    <MakeDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="@(_StageFile)" DestinationFolder="$(ModStageDir)" />
    <Copy SourceFiles="@(_StageAsset)" DestinationFiles="@(_StageAsset->'$(ModStageDir)/Assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- A folder-only build must not leave a ZIP of an older payload beside it. -->
    <Delete Files="$(ModArchive);$(ModArchive).sha256" />
    <Message Importance="high" Text="Built installable mod: $(ModStageDir)" />
  </Target>
  <Target Name="ZipModDistribution" AfterTargets="BuildModDistribution"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(CreateModZip)' == 'true'">
    <PropertyGroup>
      <_ModArchiveRoot>$(IntermediateOutputPath)mod-package</_ModArchiveRoot>
    </PropertyGroup>
    <!-- ZipDirectory archives a directory's contents. Use a private wrapper so the
         archive has one purr2d2/ root and cannot pick up sibling staging folders. -->
    <RemoveDir Directories="$(_ModArchiveRoot)" />
    <MakeDir Directories="$(_ModArchiveRoot)/purr2d2;$(MSBuildProjectDirectory)/artifacts/dist" />
    <Copy SourceFiles="@(_StageFile)" DestinationFolder="$(_ModArchiveRoot)/purr2d2" />
    <Copy SourceFiles="@(_StageAsset)" DestinationFiles="@(_StageAsset->'$(_ModArchiveRoot)/purr2d2/Assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(_ModArchiveRoot)" DestinationFile="$(ModArchive)" Overwrite="true" />
    <GetFileHash Files="$(ModArchive)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ModArchiveHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(ModArchive).sha256" Lines="@(_ModArchiveHash->'%(FileHash)  %(Filename)%(Extension)')" Overwrite="true" Encoding="ASCII" />
    <Message Importance="high" Text="Built mod archive: $(ModArchive)" />
  </Target>
  <Target Name="CleanModDistribution" AfterTargets="Clean" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(ModStageDir);$(IntermediateOutputPath)mod-package" />
    <Delete Files="$(ModArchive);$(ModArchive).sha256" />
  </Target>
</Project>
